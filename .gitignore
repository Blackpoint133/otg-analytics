# OTG Analytics public-repository safety rules

# Secrets
.env
.env.*
!.env.example
.streamlit/secrets.toml
**/.streamlit/secrets.toml

# Virtual environments
.venv/
venv/
env/

# Python-generated files and test caches
__pycache__/
**/__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Runtime state and logs
logs/
**/logs/
*.log
*.pid
*.lock

# Production/generated data
source_data/
streamlit_opensea_sales/data_opensea_sales/
*.parquet
*.feather
*.pkl
*.sqlite
*.sqlite3
*.db
*.jsonl

# Backups and temporary staging
**/.backups/
**/.publish_backups/
**/.staging/
*.bak
*.old
*.backup

# IDE and operating-system files
.vscode/
.idea/
.vs/
.DS_Store
Thumbs.db
Desktop.ini

# Browser and temporary diagnostics
chrome_tmp*/
chrome_diag*/
browser_profiles/
tmp/
temp/

# Local/server-only launcher
/streamlit_opensea_sales/start.bat

# Unused/review-required artwork for the first public snapshot
/roadmap/footer_img.png

