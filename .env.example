# PostgreSQL connection used by the application/runtime environment.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=

# GUNZscope current supply API key (staging-only; never commit .env).
API_GUNZSCOPE=

# First-party visitor analytics configuration.
OTG_ANALYTICS_WRITES_ENABLED=false

# Product usage event writes. Requires OTG_ANALYTICS_WRITES_ENABLED=true.
OTG_PRODUCT_EVENTS_ENABLED=false

# Optional local directory for rotating application logs.
OTG_LOG_DIR=
OTG_SITE_ANALYTICS_ENABLED=
OTG_SITE_ANALYTICS_HMAC_SECRET=
OTG_SITE_ANALYTICS_EXCLUDED_VISITOR_HASHES=
OTG_SITE_ANALYTICS_INTERNAL_USER_AGENT_PATTERNS=

# User feedback submission writes.
OTG_FEEDBACK_WRITES_ENABLED=false

# Telegram notification for newly submitted user feedback.
OTG_FEEDBACK_TELEGRAM_ENABLED=false
OTG_FEEDBACK_TELEGRAM_BOT_TOKEN=
OTG_FEEDBACK_TELEGRAM_CHAT_ID=

# Password for the protected internal visitor analytics dashboard.
OTG_INTERNAL_ANALYTICS_PASSWORD=

# Local GUNZscope Supply snapshot selected by the public application.
# Supported values: v1, v2, v3.
GUNZSCOPE_SUPPLY_SOURCE=v3
