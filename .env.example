# PostgreSQL connection used by the application/runtime environment.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=

# GUNZscope current supply API key (staging-only; never commit .env).
API_GUNZSCOPE=

# First-party visitor analytics configuration.
OTG_ANALYTICS_WRITES_ENABLED=false
OTG_SITE_ANALYTICS_ENABLED=
OTG_SITE_ANALYTICS_HMAC_SECRET=
OTG_SITE_ANALYTICS_EXCLUDED_VISITOR_HASHES=
OTG_SITE_ANALYTICS_INTERNAL_USER_AGENT_PATTERNS=
